.iv {
  padding-top: 24rpx;
}

.iv-hero {
  background: linear-gradient(135deg, #0E6E8C 0%, #1587A6 100%);
  border-radius: 24rpx;
  padding: 44rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(14, 110, 140, 0.18);
}

.iv-hero-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
}

.iv-hero-amount {
  font-size: 72rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.2;
  margin-top: 8rpx;
  font-variant-numeric: tabular-nums;
}

.iv-yen {
  font-size: 36rpx;
  margin-right: 4rpx;
}

.iv-hero-status {
  display: inline-block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 20rpx;
  padding: 6rpx 20rpx;
}

.iv-line {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2F5F6;
}

.iv-line:last-of-type {
  border-bottom: none;
}

.iv-line-name {
  font-size: 28rpx;
  color: #17222B;
}

.iv-line-price {
  font-size: 22rpx;
  color: #98A4AC;
  margin-top: 4rpx;
}

.iv-line-amt {
  font-size: 28rpx;
  color: #17222B;
  font-variant-numeric: tabular-nums;
}

.iv-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #E3EAED;
  font-size: 26rpx;
  color: #61707B;
}

.iv-total-amt {
  font-size: 36rpx;
  font-weight: 600;
  color: #BF4331;
}

.iv-note {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.iv-note-t {
  font-size: 26rpx;
  font-weight: 500;
  color: #4E5D68;
  margin-bottom: 10rpx;
}

.iv-note-l {
  font-size: 22rpx;
  color: #98A4AC;
  line-height: 1.8;
}

.iv-actions {
  display: flex;
  gap: 20rpx;
  padding-bottom: 24rpx;
}

.iv-actions .btn {
  flex: 1;
}
