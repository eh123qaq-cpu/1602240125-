<view class="page page-tab ap-page">

  <view class="filters">
    <view
      class="filter {{filter === item.key ? 'on' : ''}}"
      wx:for="{{filters}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="switchFilter"
    >{{item.text}}</view>
  </view>

  <skeleton wx:if="{{loading}}" rows="3"></skeleton>

  <empty-state
    wx:elif="{{!bound}}"
    text="登录后查看你的预约"
    sub="用预约时的手机号登录即可同步"
    action="去登录"
    bind:action="goLogin"
  ></empty-state>

  <empty-state
    wx:elif="{{items.length === 0}}"
    text="{{filter === 'all' ? '还没有预约记录' : '没有这类记录'}}"
    sub="{{filter === 'all' ? '选个时间，和牙医见一面' : ''}}"
    action="{{filter === 'all' ? '去预约' : ''}}"
    bind:action="goBooking"
  ></empty-state>

  <block wx:else>
    <view class="ap" wx:for="{{items}}" wx:key="_id">
      <view class="ap-hd">
        <view class="ap-when">
          <text class="ap-date">{{item.dateText}}</text>
          <text class="ap-week">{{item.weekText}}</text>
          <text class="ap-time">{{item.start}}</text>
        </view>
        <status-tag status="{{item.status}}"></status-tag>
      </view>

      <view class="ap-body">
        <view class="ap-line">
          <text class="ap-k">牙医</text>
          <text class="ap-v">{{item.dentist_name}}</text>
        </view>
        <view class="ap-line">
          <text class="ap-k">门店</text>
          <text class="ap-v">{{item.clinic_name}}</text>
        </view>
        <view class="ap-line" wx:if="{{item.need}}">
          <text class="ap-k">需求</text>
          <text class="ap-v">{{item.need}}</text>
        </view>
        <view class="ap-line" wx:if="{{item.special_need}}">
          <text class="ap-k">备注</text>
          <text class="ap-v">{{item.special_need}}</text>
        </view>
        <view class="ap-note" wx:if="{{item.status === 'CANCELLED'}}">
          取消原因：{{item.status_reason || '演示取消'}}
        </view>
        <view class="ap-note" wx:if="{{item.status === 'RESCHEDULED'}}">
          该记录已改约，请查看新的预约记录
        </view>
        <view class="ap-note" wx:if="{{item.status === 'NO_SHOW'}}">
          演示状态：未完成，可重新发起演示预约
        </view>
        <view class="ap-note" wx:if="{{item.status === 'VERIFY'}}">
          本次演示预约已过期，正在核实状态
        </view>
      </view>

      <view class="ap-foot">
        <view class="ap-act btn-sm btn-danger" wx:if="{{item.canCancel}}" data-id="{{item._id}}" bindtap="cancel">
          取消预约
        </view>
        <view class="ap-act btn-sm btn-line" wx:if="{{item.canReschedule}}" data-id="{{item._id}}" bindtap="reschedule">
          改约
        </view>
        <view class="ap-act btn-sm btn-ghost" data-id="{{item.clinic_id}}" bindtap="openClinic">门店导航</view>
      </view>
    </view>
  </block>

</view>
