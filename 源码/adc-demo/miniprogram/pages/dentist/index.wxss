.dt {
  padding-top: 24rpx;
}

.dt-hero {
  background: linear-gradient(135deg, #0E6E8C 0%, #1587A6 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.dt-avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  color: #fff;
  font-size: 48rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
}

.dt-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
}

.dt-title {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.dt-quals {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.dt-q {
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
  margin: 0 8rpx 10rpx;
}

.dt-intro {
  font-size: 26rpx;
  color: #4E5D68;
  line-height: 1.8;
}

.dt-clinic {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
}

.dt-c-name {
  font-size: 28rpx;
  font-weight: 500;
}

.dt-c-addr {
  font-size: 22rpx;
  color: #98A4AC;
  margin-top: 6rpx;
  line-height: 1.5;
}

.dt-c-arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #C6CFD5;
  border-bottom: 3rpx solid #C6CFD5;
  transform: rotate(-45deg);
  flex-shrink: 0;
}

.dt-note {
  font-size: 22rpx;
  color: #A9B4BB;
  line-height: 1.7;
  padding: 0 8rpx;
}
