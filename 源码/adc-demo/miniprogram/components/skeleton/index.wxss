.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.sk-line {
  border-radius: 10rpx;
  background: linear-gradient(90deg, #EEF2F4 25%, #F7FAFB 37%, #EEF2F4 63%);
  background-size: 400% 100%;
  animation: sk 1.4s ease infinite;
  height: 26rpx;
  margin-bottom: 20rpx;
}

.sk-line:last-child {
  margin-bottom: 0;
}

.sk-title {
  width: 42%;
  height: 34rpx;
}

.sk-sub {
  width: 66%;
}

.sk-body {
  width: 88%;
}

.sk-row {
  width: 100%;
  height: 120rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

@keyframes sk {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}
