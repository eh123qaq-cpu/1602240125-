<view class="tabbar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tabbar-item {{selected === index ? 'is-on' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tabbar-icon i-{{item.icon}} {{selected === index ? 'is-on' : ''}}"></view>
    <text class="tabbar-text">{{item.text}}</text>
  </view>
</view>
