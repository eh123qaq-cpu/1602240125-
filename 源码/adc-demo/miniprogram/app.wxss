/* ==========================================================================
   ADC 安德鲁牙科 · 设计系统
   颜色 / 字号 / 间距 / 组件基类，所有页面共用这一份，避免各页各写一套
   ========================================================================== */

page {
  --brand: #0E6E8C;
  --brand-deep: #0A5468;
  --brand-soft: #E7F1F5;
  --text: #17222B;
  --sub: #61707B;
  --hint: #98A4AC;
  --line: #EDF1F3;

  background: #F4F6F8;
  color: #17222B;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, button, input, textarea, scroll-view, picker {
  box-sizing: border-box;
}

/* ------------------------------ 布局 ------------------------------ */

.page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

.page-tab {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(23, 34, 43, 0.05);
}

.card-flat {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #EDF1F3;
}

.card-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #17222B;
  letter-spacing: 0.5rpx;
}

.card-more {
  font-size: 24rpx;
  color: #98A4AC;
}

.section-title {
  font-size: 26rpx;
  color: #61707B;
  margin: 8rpx 4rpx 16rpx;
  letter-spacing: 1rpx;
}

/* ------------------------------ 文字 ------------------------------ */

.t-xl { font-size: 44rpx; font-weight: 600; letter-spacing: -0.5rpx; }
.t-lg { font-size: 36rpx; font-weight: 600; }
.t-md { font-size: 30rpx; font-weight: 500; }
.t-sm { font-size: 26rpx; }
.t-xs { font-size: 22rpx; }

.sub { color: #61707B; }
.hint { color: #98A4AC; font-size: 24rpx; line-height: 1.6; }
.bold { font-weight: 600; }
.mono { font-family: 'SF Mono', Menlo, Consolas, monospace; letter-spacing: 0.5rpx; }

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.amount {
  font-size: 40rpx;
  font-weight: 600;
  color: #BF4331;
  font-variant-numeric: tabular-nums;
}

.amount::before {
  content: '¥';
  font-size: 26rpx;
  margin-right: 2rpx;
}

/* ------------------------------ 列表行 ------------------------------ */

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #EDF1F3;
}

.row:last-child {
  border-bottom: none;
}

.row-label {
  font-size: 28rpx;
  color: #61707B;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.row-value {
  font-size: 28rpx;
  color: #17222B;
  text-align: right;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-arrow::after {
  content: '';
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #C6CFD5;
  border-bottom: 3rpx solid #C6CFD5;
  transform: rotate(-45deg);
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* ------------------------------ 按钮 ------------------------------ */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  border: none;
  margin: 0;
  padding: 0;
  line-height: 1;
}

.btn::after {
  border: none;
}

.btn-main {
  background: linear-gradient(135deg, #12819F 0%, #0A5468 100%);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(14, 110, 140, 0.24);
}

.btn-main[disabled] {
  background: #C3D3D9;
  color: #fff;
  box-shadow: none;
}

.btn-line {
  background: #fff;
  color: #0E6E8C;
  border: 1rpx solid #B9D6DF;
}

.btn-ghost {
  background: #F4F6F8;
  color: #61707B;
}

.btn-danger {
  background: #fff;
  color: #BF4331;
  border: 1rpx solid #F0C9C1;
}

.btn-sm {
  height: 64rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  padding: 0 28rpx;
  display: inline-flex;
}

.btn-block {
  width: 100%;
}

/* ------------------------------ 标签 ------------------------------ */

.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 500;
}

.tag + .tag {
  margin-left: 10rpx;
}

.tag-blue { background: #E7F1F5; color: #0E6E8C; }
.tag-green { background: #E4F3EE; color: #0F7A5F; }
.tag-amber { background: #FBF0D8; color: #9A6400; }
.tag-red { background: #FBE9E5; color: #BF4331; }
.tag-gray { background: #EFF2F4; color: #61707B; }

/* ------------------------------ 表单 ------------------------------ */

.field {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #EDF1F3;
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  width: 176rpx;
  font-size: 28rpx;
  color: #61707B;
  flex-shrink: 0;
}

.field-input {
  flex: 1;
  font-size: 30rpx;
  color: #17222B;
  text-align: right;
}

.field-input-placeholder {
  color: #C1CAD0;
  font-size: 28rpx;
}

/* ------------------------------ 固定底栏 ------------------------------ */

.fixed-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #EDF1F3;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  z-index: 60;
}

.fixed-bar-info {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #61707B;
  line-height: 1.5;
  margin-right: 20rpx;
}

.fixed-bar .btn {
  flex: 1;
}

.fixed-bar .btn-auto {
  flex: 0 0 auto;
  padding: 0 40rpx;
}

/* ------------------------------ 骨架屏 ------------------------------ */

.sk {
  background: linear-gradient(90deg, #EEF2F4 25%, #F6F9FA 37%, #EEF2F4 63%);
  background-size: 400% 100%;
  animation: sk-loading 1.4s ease infinite;
  border-radius: 12rpx;
}

@keyframes sk-loading {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* ------------------------------ 通用小件 ------------------------------ */

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #C6CFD5;
  display: inline-block;
}

.divider {
  height: 1rpx;
  background: #EDF1F3;
  margin: 24rpx 0;
}

.gap-16 { height: 16rpx; }
.gap-24 { height: 24rpx; }

.flex { display: flex; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; min-width: 0; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }

/* 点击态，替代每个元素重复写 hover-class */
.tap {
  transition: opacity 0.15s ease;
}

.tap:active {
  opacity: 0.72;
}
